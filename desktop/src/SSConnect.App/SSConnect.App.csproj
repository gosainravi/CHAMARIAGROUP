    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>SS-Connect</AssemblyName>
    <RootNamespace>SSConnect.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>SS-Connect</Product>
    <AssemblyTitle>SS-Connect Remote Support</AssemblyTitle>
    <Description>Screen sharing and remote control with on-screen permission (Allow / Deny).</Description>
    <Company>Chamaria Group</Company>
    <Copyright>© 2026 Chamaria Group</Copyright>
    <Version>1.0.2</Version>
    <FileVersion>1.0.2.0</FileVersion>
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SSConnect.Core\SSConnect.Core.csproj" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Costura.Fody" Version="5.7.0" PrivateAssets="all" />
  </ItemGroup>
</Project>
